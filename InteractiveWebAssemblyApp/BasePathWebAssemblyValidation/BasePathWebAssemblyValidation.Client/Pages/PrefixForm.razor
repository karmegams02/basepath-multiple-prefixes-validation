@page "/prefix-form"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Prefix form</PageTitle>

<h1>Prefix form</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label for="name">Name</label>
    <InputText id="name" @bind-Value="model.Name" />

    <button id="submit" type="submit">Submit</button>
</EditForm>

@if (result is not null)
{
    <p id="result">
        Submitted: @result.Name; Prefix: @result.Prefix
    </p>
}

@code {
    private FormModel model = new();
    private PrefixFormResponse? result;

    private async Task SubmitAsync()
    {
        using var response = await Http.PostAsJsonAsync(
            "api/prefix-form",
            new PrefixFormRequest(model.Name));

        response.EnsureSuccessStatusCode();
        result = await response.Content.ReadFromJsonAsync<PrefixFormResponse>();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "";
    }

    private sealed record PrefixFormRequest(string Name);
    private sealed record PrefixFormResponse(string Name, string Prefix);
}