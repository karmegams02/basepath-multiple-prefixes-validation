{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "alpha-route": {
        "ClusterId": "test-app",
        "Match": { "Path": "/alpha/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/alpha" },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/alpha"
          }
        ]
      },
      "beta-route": {
        "ClusterId": "test-app",
        "Match": { "Path": "/beta/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/beta" },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/beta"
          }
        ]
      },
      "gamma-route": {
        "ClusterId": "test-app",
        "Match": { "Path": "/gamma/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gamma" },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/gamma"
          }
        ]
      }
    },
    "Clusters": {
      "test-app": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5081/" }
        }
      }
    }
  }
}
