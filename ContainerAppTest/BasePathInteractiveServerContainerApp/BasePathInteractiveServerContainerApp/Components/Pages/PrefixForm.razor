@page "/prefix-form"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Prefix form</PageTitle>

<h1>Prefix form</h1>

<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label for="name">Name</label>
    <InputText id="name" @bind-Value="model.Name" />

    <button id="submit" type="submit">Submit</button>
</EditForm>

@if (result is not null)
{
    <p id="result">
        Submitted: @result.Name; Prefix: @result.Prefix
    </p>
}

@code {
    private FormModel model = new();
    private PrefixFormResponse? result;

    private async Task SubmitAsync()
    {
        var requestUri = new Uri(new Uri(Navigation.BaseUri), "api/prefix-form");
        result = await JS.InvokeAsync<PrefixFormResponse>(
            "prefixForm.submit", requestUri, model.Name);
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "";
    }

    private sealed record PrefixFormRequest(string Name);
    private sealed record PrefixFormResponse(string Name, string Prefix);
}